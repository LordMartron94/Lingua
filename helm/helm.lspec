--- "Helm" v0.1.0 | lspec v1.0.0 ---

PRAGMA {
	tool.sublime {
		enable = true;
		output-path = [
			"libs/lingua/helm/artifacts/helm.sublime-syntax",
			"/home/user/.config/sublime-text/Packages/User/helm.sublime-syntax"
		];
	}

	tool.go_bindings {
		enable = true;
		output-path = "libs/lingua/helm/artifacts/go_bindings.go";
		package-name = "artifacts";
	}

	tool.tm_comments {
		enable = true;
		output-path = [
			"/home/user/.config/sublime-text/Packages/User/Comments (Helm).tmPreferences"
		];
		scope-extension = ".helm";
		single-line-comment-start = "// ";
		block-comment-start = "/*";
		block-comment-end = "*/";
	}
};

IMPORT {
	embed "../lspec_std/std.lspec" as STD;
}

PATTERN {
	pat_TokEOF				: [];
	pat_TokWhitespace       : (['\t', ' '])+;
	pat_TokNewLine			: (['\n', '\r'])+;

	pat_TokLineComment      : "/" "/" (!['\n', '\r'])*;
	pat_TokBlockComment     : "/" "*" ((!'*' | ("*")+ !['*', '/']))* ("*")+ "/";

	pat_TokEquals			: '=';

	pat_TokStringStart      : "\"";
	pat_TokStringEnd        : "\"";
	pat_TokStringEscape     : ("\\" ['"', '\\', 'n', 'r', 't'] | ("\\u" (['0'..'9', 'A'..'F', 'a'..'f']){4,4} | "\\U" (['0'..'9', 'A'..'F', 'a'..'f']){8,8}));
	pat_TokStringLiteral    : (!['\n', '\r', '"', '\\', '$'])+;
	pat_TokIdentifier       : ['A'..'Z', '_', 'a'..'z'] (['-', '0'..'9', 'A'..'Z', '_', 'a'..'z'])*;

	pat_TokDollar    			: "$";
	pat_TokInterpolationStart 	: "${";
	pat_TokInterpolationEnd   	: "}";

	pat_TokKWTarget			  	: "target";
	pat_TokKWHelp				: "help";
	pat_TokKWCache				: "cache";
	pat_TokKWInputs				: "inputs";
	pat_TokKWGlob				: "glob";
	pat_TokKWOutput 			: "output";
	pat_TokKWPath				: "path";
	pat_TokKWBypass				: "bypass";

	pat_TokKWWhen				: "when";

	pat_TokKWDefined			: "defined";
	pat_TokKWNotDefined			: "not_defined";
	pat_TokKWEquals				: "equals";
	pat_TokKWNotEquals			: "not_equals";

	pat_TokInteger 				: '0' | ['1'..'9'] ['0'..'9']+;

	pat_TokKWRun				: "run";

	pat_TokKWTrue				: "true";
	pat_TokKWFalse				: "false";

	pat_TokParenOpen 			: '(';
	pat_TokParenClose			: ')';
	pat_TokQuestion				: '?';
	pat_TokComma				: ',';
	pat_TokBraceOpen			: '{';
	pat_TokBraceClose			: "}"; 
	pat_TokBracketOpen			: "[";
	pat_TokBracketClose			: "]";
}

LEX {
	state INITIAL {
		// Keywords
		2 TokKWTarget 			-> HELM_STRUCTURAL_ROLE : pat_TokKWTarget;
		2 TokKWHelp 			-> HELM_STRUCTURAL_ROLE : pat_TokKWHelp;
		2 TokKWCache 			-> HELM_STRUCTURAL_ROLE : pat_TokKWCache;
		2 TokKWInputs 			-> HELM_STRUCTURAL_ROLE : pat_TokKWInputs;
		2 TokKWGlob 			-> HELM_STRUCTURAL_ROLE : pat_TokKWGlob;
		2 TokKWOutput 			-> HELM_STRUCTURAL_ROLE : pat_TokKWOutput;
		2 TokKWPath 			-> HELM_STRUCTURAL_ROLE : pat_TokKWPath;
		2 TokKWBypass 			-> HELM_STRUCTURAL_ROLE : pat_TokKWBypass;

		2 TokKWTrue 			-> HELM_STRUCTURAL_ROLE : pat_TokKWTrue;
		2 TokKWFalse 			-> HELM_STRUCTURAL_ROLE : pat_TokKWFalse;

		2 TokKWWhen 			-> HELM_STRUCTURAL_ROLE : pat_TokKWWhen;

		2 TokKWDefined 			-> HELM_STRUCTURAL_ROLE : pat_TokKWDefined;
		2 TokKWNotDefined 		-> HELM_STRUCTURAL_ROLE : pat_TokKWNotDefined;
		2 TokKWEquals 			-> HELM_STRUCTURAL_ROLE : pat_TokKWEquals;
		2 TokKWNotEquals 		-> HELM_STRUCTURAL_ROLE : pat_TokKWNotEquals;

		2 TokKWRun 				-> HELM_STRUCTURAL_ROLE : pat_TokKWRun;

		// Conventional
		1 TokIdentifier 		-> HELM_STRUCTURAL_ROLE : pat_TokIdentifier;
		1 TokStringStart 		-> HELM_STRUCTURAL_ROLE : pat_TokStringStart [push(STRING)];
		1 TokInteger 			-> HELM_STRUCTURAL_ROLE : pat_TokInteger;

		// // Operators
		1 TokEquals 			-> HELM_STRUCTURAL_ROLE : pat_TokEquals;
		1 TokQuestion 			-> HELM_STRUCTURAL_ROLE : pat_TokQuestion;

		// Structure
		1 TokBraceOpen 			-> HELM_STRUCTURAL_ROLE : pat_TokBraceOpen;
		1 TokBraceClose 		-> HELM_STRUCTURAL_ROLE : pat_TokBraceClose;
		1 TokParenOpen 			-> HELM_STRUCTURAL_ROLE : pat_TokParenOpen;
		1 TokParenClose 		-> HELM_STRUCTURAL_ROLE : pat_TokParenClose;
		1 TokComma 				-> HELM_STRUCTURAL_ROLE : pat_TokComma;
		1 TokBracketOpen		-> HELM_STRUCTURAL_ROLE : pat_TokBracketOpen;
		1 TokBracketClose 		-> HELM_STRUCTURAL_ROLE : pat_TokBracketClose;

	    // Hidden/Whitespace
	    0 TokWhitespace         -> HELM_WHITESPACE_ROLE : pat_TokWhitespace;
		0 TokNewLine            -> HELM_STRUCTURAL_ROLE : pat_TokNewLine;

	    0 TokBlockComment       -> HELM_COMMENT_ROLE    : pat_TokBlockComment;
	    0 TokLineComment        -> HELM_COMMENT_ROLE    : pat_TokLineComment;

	    // End of File
	    0 TokEOF                -> HELM_STRUCTURAL_ROLE : pat_TokEOF %% EOF=true %%;
	}

	state STRING {
		2 TokInterpolationStart -> HELM_STRUCTURAL_ROLE : pat_TokInterpolationStart [push(INTERPOLATION)];
		1 TokStringEscape       -> HELM_STRUCTURAL_ROLE : pat_TokStringEscape;
		1 TokDollar         	-> HELM_STRUCTURAL_ROLE : pat_TokDollar;
		1 TokStringLiteral      -> HELM_STRUCTURAL_ROLE : pat_TokStringLiteral;
		1 TokStringEnd          -> HELM_STRUCTURAL_ROLE : pat_TokStringEnd [pop(1)];
	}

	state INTERPOLATION {
		1 TokIdentifier       -> HELM_STRUCTURAL_ROLE : pat_TokIdentifier;
		1 TokInterpolationEnd -> HELM_STRUCTURAL_ROLE : pat_TokInterpolationEnd [pop(1)];
		
		// Optional: allow whitespace inside the brackets
		0 TokWhitespace       -> HELM_WHITESPACE_ROLE : pat_TokWhitespace;
	}
}

PARSE {
	IGNORE {
		HELM_WHITESPACE_ROLE HELM_COMMENT_ROLE
	}

	// --- ENTRY ---

	rule PROGRAM -> NodeProgram {
		(
			NEW_LINE | VARIABLE_STATEMENT | TARGET
		)*
		virtual TokEOF
	}

	// --- VARIABLES ---

	rule VARIABLE_STATEMENT -> NodeVariableDeclaration {
		NodeVariableName : TokIdentifier
		virtual TokEquals
		VARIABLE_TARGET
		NEW_LINE
	}

	rule VARIABLE_TARGET -> NodeVariableValue {
		STRING_LITERAL
	}

	// --- TARGETS ---

	pair Parens TokParenOpen TokParenClose;
	pair Braces TokBraceOpen TokBraceClose;

	rule TARGET -> NodeTarget {	
		virtual TokKWTarget
		NodeTargetIdentifier : TokIdentifier
		nest @Parens {
			TARGET_PARAMS
		}
		nest @Braces {
			TARGET_BODY
		}
	}

	rule TARGET_PARAMS -> NodeTargetParams {
		(
			TARGET_PARAM
			(
				virtual TokComma
				TARGET_PARAM
			)*
		)?
	}

	rule TARGET_PARAM -> NodeTargetParameter {
		NodeTargetParameterIdentifier : TokIdentifier
		NodeTargetParameterOptional : TokQuestion?
	}

	rule TARGET_BODY -> NodeTargetBody {
		(
			NEW_LINE | HELP_STATEMENT | CACHE_BLOCK | CONDITIONAL_BLOCK
		)*
	}

	rule HELP_STATEMENT -> NodeHelpStatement {
		virtual TokKWHelp
		virtual TokEquals
		STRING_LITERAL
	} 

	rule CACHE_BLOCK -> NodeCacheBlock {
		virtual TokKWCache
		nest @Braces {
			CACHE_BLOCK_CONTENT
		}
	}

	rule CACHE_BLOCK_CONTENT -> transparent gr_CACHE_BLOCK_CONTENT {
		(
			(
				NEW_LINE
				| INPUTS_STATEMENT
				| OUTPUT_STATEMENT
				| BYPASS_STATEMENT
			)
		)*
	}

	template t_cacheAssignment($keyword: Token, $rule: Rule) {
		virtual $keyword
		virtual TokEquals
		$rule
	}

	rule INPUTS_STATEMENT -> NodeCacheInputs {
		call t_cacheAssignment(TokKWInputs, INPUTS_VALUE)
		NEW_LINE
	}

	rule INPUTS_VALUE -> transparent gr_INPUTS_VALUE {
		STRING_ARRAY | GLOB
	}

	rule GLOB -> NodeGlob {
		virtual TokKWGlob
		nest @Parens {
			GLOB_ARGS
		}
	}

	rule GLOB_ARGS -> NodeGlobArguments {
		GLOB_BASE_DIR
		(
			virtual TokComma
			GLOB_KWARG
		)*
	}

	rule GLOB_BASE_DIR -> NodeGlobBaseDirectory {
		VAR_REF
		| STRING_LITERAL
	}

	rule GLOB_KWARG -> NodeGlobKwarg {
		NodeGlobKwargIdentifier : TokIdentifier
		virtual TokEquals
		STRING_LITERAL
	}

	rule OUTPUT_STATEMENT -> NodeCacheOutputDirectory {
		virtual TokKWOutput
		virtual TokEquals
		OUTPUT_STATEMENT_VALUE
		NEW_LINE
	}

	rule OUTPUT_STATEMENT_VALUE -> transparent gr_OUTPUT_VALUE {
		VAR_REF | STRING_LITERAL | PATH
	}
	
	rule PATH -> NodePath {
		virtual TokKWPath
		nest @Parens {
			PATH_ARGS
		}
	}

	rule PATH_ARGS -> NodePathArgs {
		PATH_ELEMENT
		(
			virtual TokComma
			PATH_ELEMENT
		)*
	}

	rule PATH_ELEMENT -> transparent gr_PATH_ELEMENT {
		VAR_REF | STRING_LITERAL
	}

	rule BYPASS_STATEMENT -> NodeBypass {
		virtual TokKWBypass
		virtual TokEquals
		NodeBypassValue : (virtual TokKWTrue | virtual TokKWFalse)
		NEW_LINE
	}

	rule CONDITIONAL_BLOCK -> NodeConditional {
		virtual TokKWWhen

		(DEFINES | EQUALS)

		nest @Braces {
			(
				NEW_LINE
				| TARGET_EXECUTION
			)*
		}	
	}

	rule DEFINES -> transparent gr_DEFINES {
		NodeCondition : (virtual TokKWDefined | virtual TokKWNotDefined)
		nest @Parens {
			NodeConditionalParameter : TokIdentifier
		}
	}

	rule EQUALS -> transparent gr_EQUALS {
		NodeCondition : (virtual TokKWEquals | virtual TokKWNotEquals)
		nest @Parens {
			NodeConditionalParameter : TokIdentifier
			virtual TokComma
			CONDITIONAL_TARGET 
		}
	}

	rule CONDITIONAL_TARGET -> NodeConditionalTarget {
		STRING_LITERAL | NodeNumber : TokInteger
	}

	rule TARGET_EXECUTION -> NodeTargetExecution {
		RUN // For now only Run, maybe more later
	}

	rule RUN -> NodeRunStatement {
		virtual TokKWRun
		STRING_LITERAL
		NEW_LINE
	}

	// --- STRINGS ---

	rule STRING_ARRAY -> NodeStringArray {
		using STD.t_ARRAY(TokBracketOpen, TokBracketClose, STRING_LITERAL, TokComma)
	}

	rule STRING_LITERAL -> NodeStringLiteral {
		virtual TokStringStart
		(
			STRING_INTERPOLATION
			| virtual TokStringEscape
			| NodeStringText : TokStringLiteral
			| NodeStringDollar : TokDollar
		)*
		virtual TokStringEnd
	}

	rule STRING_INTERPOLATION -> NodeStringInterpolation {
		virtual TokInterpolationStart
		NodeInterpolatedVariable : TokIdentifier
		virtual TokInterpolationEnd
	}

	// --- OTHER ---

	rule VAR_REF -> transparent gr_VAR_REF {
		NodeVariableReference : TokIdentifier
	}

	rule NEW_LINE -> NodeNewLine {
		virtual TokNewLine
	}
}