--- "Helm" v2.0.0 | lspec v1.0.0 ---

PRAGMA {
	tool.sublime {
		enable = true;
		output-path = "artifacts/helm.sublime-syntax";
	}

	tool.go_bindings {
		enable = true;
		output-path = "artifacts/go_bindings.go";
		package-name = "artifacts";
	}

	tool.tm_comments {
		enable = true;
		output-path = "artifacts/Comments (Helm).tmPreferences";
		scope-extension = ".helm";
		single-line-comment-start = "// ";
		block-comment-start = "/*";
		block-comment-end = "*/";
	}
};

IMPORT {
	embed "../lspec_std/std.lspec" as STD;
}

PATTERN {
	pat_TokEOF				: [];
	pat_TokWhitespace       : (['\t', ' '])+;
	pat_TokNewLine			: (['\n', '\r'])+;

	pat_TokLineComment      : "/" "/" (!['\n', '\r'])*;
	pat_TokBlockComment     : "/" "*" ((!'*' | ("*")+ !['*', '/']))* ("*")+ "/";

	pat_TokEquals			: '=';

	pat_TokStringStart      	: "\"";
	pat_TokStringEnd        	: "\"";
	pat_TokEmptyString      	: "\"\"";
	pat_TokMultilineStringStart	: "\"\"\"";
	pat_TokMultilineStringEnd	: "\"\"\"";
	pat_TokStringEscape     	: ("\\" ['"', '\\', 'n', 'r', 't'] | ("\\u" (['0'..'9', 'A'..'F', 'a'..'f']){4,4} | "\\U" (['0'..'9', 'A'..'F', 'a'..'f']){8,8}));
	pat_TokStringLiteral    	: (!['\n', '\r', '"', '\\', '$'])+;
	pat_TokMultilineStringText	: (!['"', '\\', '$'])+;
	
	pat_TokIdentifier       : ['A'..'Z', '_', 'a'..'z'] (['-', '0'..'9', 'A'..'Z', '_', 'a'..'z'])*;

	pat_TokDollar    			: "$";
	pat_TokInterpolationStart 	: "${";
	pat_TokInterpolationEnd   	: "}";

	pat_TokKWWorkspace			: "workspace";
	pat_TokKWEntity				: "entity";
	pat_TokKWInterface			: "interface";
	pat_TokKWAdapter			: "adapter";
	pat_TokKWGlobals			: "globals";
	pat_TokKWExclude			: "exclude";
	pat_TokKWInclude			: "include";
	pat_TokKWUse				: "use";
	pat_TokKWUsage				: "usage";
	pat_TokKWKind				: "kind";
	pat_TokKWDeps				: "deps";
	pat_TokKWKeys				: "keys";
	pat_TokKWTarget			  	: "target";
	pat_TokKWHelp				: "help";
	pat_TokKWArtifacts			: "artifacts";
	pat_TokKWInputs				: "inputs";
	pat_TokKWGlob				: "glob";
	pat_TokKWOutputs 			: "outputs";
	pat_TokKWPath				: "path";
	pat_TokKWAliases			: "aliases";
	pat_TokKWVolatile   		: "volatile";
	pat_TokKWEnv 				: "env";
	pat_TokKWWorkingDir			: "workdir";
	pat_TokKWMatrix 			: "matrix";
	pat_TokKWIn 				: "in";
	pat_TokKWInteractive		: "interactive";
	pat_TokKWHidden				: "hidden";

	pat_TokKWConfirm			: "confirm";
	pat_TokKWOptional			: "optional";
	pat_TokKWParams				: "params";
	pat_TokKWParam				: "param";
	pat_TokKWCollect			: "collect";
	pat_TokKWCollectClosure		: "collect_closure";

	pat_TokKWWhen				: "when";

	pat_TokKWDependsOn			: "depends_on";

	pat_TokKWDefined			: "defined";
	pat_TokKWNotDefined			: "not_defined";
	pat_TokKWEquals				: "equals";
	pat_TokKWNotEquals			: "not_equals";
	pat_TokKWDynamic			: "dynamic";

	pat_TokInteger 				: '0' | ['1'..'9'] ['0'..'9']+;

	pat_TokKWLet				: "let";

	pat_TokKWExport				: "export";

	pat_TokKWRun				: "run";

	pat_TokKWTrue				: "true";
	pat_TokKWFalse				: "false";

	pat_TokParenOpen 			: '(';
	pat_TokParenClose			: ')';
	pat_TokQuestion				: '?';
	pat_TokComma				: ',';
	pat_TokDot					: '.';
	pat_TokBraceOpen			: '{';
	pat_TokBraceClose			: "}"; 
	pat_TokBracketOpen			: "[";
	pat_TokBracketClose			: "]";
}

LEX {
	state INITIAL {
		// Keywords
		3 TokKWWorkspace		-> HELM_STRUCTURAL_ROLE : pat_TokKWWorkspace;
		3 TokKWEntity			-> HELM_STRUCTURAL_ROLE : pat_TokKWEntity;
		3 TokKWInterface		-> HELM_STRUCTURAL_ROLE : pat_TokKWInterface;
		3 TokKWAdapter			-> HELM_STRUCTURAL_ROLE : pat_TokKWAdapter;
		3 TokKWGlobals			-> HELM_STRUCTURAL_ROLE : pat_TokKWGlobals;
		3 TokKWExclude			-> HELM_STRUCTURAL_ROLE : pat_TokKWExclude;
		3 TokKWInclude			-> HELM_STRUCTURAL_ROLE : pat_TokKWInclude;
		3 TokKWUse				-> HELM_STRUCTURAL_ROLE : pat_TokKWUse;
		3 TokKWUsage			-> HELM_STRUCTURAL_ROLE : pat_TokKWUsage;
		3 TokKWKind				-> HELM_STRUCTURAL_ROLE : pat_TokKWKind;
		3 TokKWDeps				-> HELM_STRUCTURAL_ROLE : pat_TokKWDeps;
		3 TokKWKeys				-> HELM_STRUCTURAL_ROLE : pat_TokKWKeys;
		3 TokKWTarget 			-> HELM_STRUCTURAL_ROLE : pat_TokKWTarget;
		3 TokKWHelp 			-> HELM_STRUCTURAL_ROLE : pat_TokKWHelp;
		3 TokKWArtifacts		-> HELM_STRUCTURAL_ROLE : pat_TokKWArtifacts;
		3 TokKWInputs 			-> HELM_STRUCTURAL_ROLE : pat_TokKWInputs;
		3 TokKWGlob 			-> HELM_STRUCTURAL_ROLE : pat_TokKWGlob;
		3 TokKWOutputs 			-> HELM_STRUCTURAL_ROLE : pat_TokKWOutputs;
		3 TokKWPath 			-> HELM_STRUCTURAL_ROLE : pat_TokKWPath;
		3 TokKWAliases 			-> HELM_STRUCTURAL_ROLE : pat_TokKWAliases;
		3 TokKWVolatile 		-> HELM_STRUCTURAL_ROLE : pat_TokKWVolatile;
		3 TokKWMatrix 			-> HELM_STRUCTURAL_ROLE : pat_TokKWMatrix;
		3 TokKWIn 				-> HELM_STRUCTURAL_ROLE : pat_TokKWIn;
		3 TokKWInteractive 		-> HELM_STRUCTURAL_ROLE : pat_TokKWInteractive;
		3 TokKWHidden 			-> HELM_STRUCTURAL_ROLE : pat_TokKWHidden;
		3 TokKWDynamic 			-> HELM_STRUCTURAL_ROLE : pat_TokKWDynamic;

		3 TokKWEnv 				-> HELM_STRUCTURAL_ROLE : pat_TokKWEnv;
		3 TokKWWorkingDir 		-> HELM_STRUCTURAL_ROLE : pat_TokKWWorkingDir;

		3 TokKWTrue 			-> HELM_STRUCTURAL_ROLE : pat_TokKWTrue;
		3 TokKWFalse 			-> HELM_STRUCTURAL_ROLE : pat_TokKWFalse;

		3 TokKWConfirm 			-> HELM_STRUCTURAL_ROLE : pat_TokKWConfirm;
		3 TokKWOptional 		-> HELM_STRUCTURAL_ROLE : pat_TokKWOptional;
		3 TokKWParams 			-> HELM_STRUCTURAL_ROLE : pat_TokKWParams;
		3 TokKWParam 			-> HELM_STRUCTURAL_ROLE : pat_TokKWParam;

		3 TokKWCollect 			-> HELM_STRUCTURAL_ROLE : pat_TokKWCollect;
		3 TokKWCollectClosure 	-> HELM_STRUCTURAL_ROLE : pat_TokKWCollectClosure;

		3 TokKWDependsOn 		-> HELM_STRUCTURAL_ROLE : pat_TokKWDependsOn;

		3 TokKWWhen 			-> HELM_STRUCTURAL_ROLE : pat_TokKWWhen;

		3 TokKWDefined 			-> HELM_STRUCTURAL_ROLE : pat_TokKWDefined;
		3 TokKWNotDefined 		-> HELM_STRUCTURAL_ROLE : pat_TokKWNotDefined;
		3 TokKWEquals 			-> HELM_STRUCTURAL_ROLE : pat_TokKWEquals;
		3 TokKWNotEquals 		-> HELM_STRUCTURAL_ROLE : pat_TokKWNotEquals;

		3 TokKWLet 				-> HELM_STRUCTURAL_ROLE : pat_TokKWLet;

		3 TokKWExport 			-> HELM_STRUCTURAL_ROLE : pat_TokKWExport;

		3 TokKWRun 				-> HELM_STRUCTURAL_ROLE : pat_TokKWRun;

		// Conventional
		3 TokEmptyString				-> HELM_STRUCTURAL_ROLE : pat_TokEmptyString;
		2 TokMultilineStringStart 		-> HELM_STRUCTURAL_ROLE : pat_TokMultilineStringStart 	[push(MULTILINE_STRING)];
		1 TokIdentifier 				-> HELM_STRUCTURAL_ROLE : pat_TokIdentifier;
		1 TokStringStart 				-> HELM_STRUCTURAL_ROLE : pat_TokStringStart 			[push(STRING)];
		1 TokInteger 					-> HELM_STRUCTURAL_ROLE : pat_TokInteger;

		// // Operators
		1 TokEquals 			-> HELM_STRUCTURAL_ROLE : pat_TokEquals;
		1 TokQuestion 			-> HELM_STRUCTURAL_ROLE : pat_TokQuestion;

		// Structure
		1 TokBraceOpen 			-> HELM_STRUCTURAL_ROLE : pat_TokBraceOpen;
		1 TokBraceClose 		-> HELM_STRUCTURAL_ROLE : pat_TokBraceClose;
		1 TokParenOpen 			-> HELM_STRUCTURAL_ROLE : pat_TokParenOpen;
		1 TokParenClose 		-> HELM_STRUCTURAL_ROLE : pat_TokParenClose;
		1 TokComma 				-> HELM_STRUCTURAL_ROLE : pat_TokComma;
		1 TokDot					-> HELM_STRUCTURAL_ROLE : pat_TokDot;
		1 TokBracketOpen		-> HELM_STRUCTURAL_ROLE : pat_TokBracketOpen;
		1 TokBracketClose 		-> HELM_STRUCTURAL_ROLE : pat_TokBracketClose;

	    // Hidden/Whitespace
	    0 TokWhitespace         -> HELM_WHITESPACE_ROLE : pat_TokWhitespace;
		0 TokNewLine            -> HELM_STRUCTURAL_ROLE : pat_TokNewLine;

	    0 TokBlockComment       -> HELM_COMMENT_ROLE    : pat_TokBlockComment;
	    0 TokLineComment        -> HELM_COMMENT_ROLE    : pat_TokLineComment;

	    // End of File
	    0 TokEOF                -> HELM_STRUCTURAL_ROLE : pat_TokEOF %% EOF=true %%;
	}

	state STRING {
		2 TokInterpolationStart -> HELM_STRUCTURAL_ROLE : pat_TokInterpolationStart [push(INTERPOLATION)];
		1 TokStringEscape       -> HELM_STRUCTURAL_ROLE : pat_TokStringEscape;
		1 TokDollar         	-> HELM_STRUCTURAL_ROLE : pat_TokDollar;
		1 TokStringLiteral      -> HELM_STRUCTURAL_ROLE : pat_TokStringLiteral;
		1 TokStringEnd          -> HELM_STRUCTURAL_ROLE : pat_TokStringEnd [pop(1)];
	}

	state MULTILINE_STRING {
		2 TokInterpolationStart 		-> HELM_STRUCTURAL_ROLE : pat_TokInterpolationStart [push(INTERPOLATION)];
		1 TokStringEscape       		-> HELM_STRUCTURAL_ROLE : pat_TokStringEscape;
		1 TokDollar         			-> HELM_STRUCTURAL_ROLE : pat_TokDollar;
		1 TokMultilineStringText		-> HELM_STRUCTURAL_ROLE : pat_TokMultilineStringText;
		2 TokMultilineStringEnd         -> HELM_STRUCTURAL_ROLE : pat_TokMultilineStringEnd [pop(1)];
	}

	state INTERPOLATION {
		1 TokIdentifier       -> HELM_STRUCTURAL_ROLE : pat_TokIdentifier;
		1 TokInterpolationEnd -> HELM_STRUCTURAL_ROLE : pat_TokInterpolationEnd [pop(1)];
		
		// Optional: allow whitespace inside the brackets
		0 TokWhitespace       -> HELM_WHITESPACE_ROLE : pat_TokWhitespace;
	}
}

PARSE {
	IGNORE {
		HELM_WHITESPACE_ROLE HELM_COMMENT_ROLE
	}

	// --- ENTRY ---

	rule PROGRAM -> NodeProgram {
		(
			NEW_LINE | VARIABLE_STATEMENT | WORKSPACE_BLOCK | TARGET
			| ENTITY | INTERFACE_DECL | ADAPTER_DECL
		)*
		virtual TokEOF
	}

	// --- WORKSPACE (Helm 2.0) ---

	rule WORKSPACE_BLOCK -> NodeWorkspace {
		virtual TokKWWorkspace
		nest @Braces {
			WORKSPACE_BODY
		}
	}

	rule WORKSPACE_BODY -> NodeWorkspaceBody sync (TokNewLine) {
		(
			NEW_LINE | WORKSPACE_GLOBALS_BLOCK | WORKSPACE_EXCLUDE
		)*
	}

	rule WORKSPACE_GLOBALS_BLOCK -> NodeWorkspaceGlobals {
		virtual TokKWGlobals
		nest @Braces {
			WORKSPACE_GLOBALS_BODY
		}
	}

	rule WORKSPACE_GLOBALS_BODY -> NodeWorkspaceGlobalsBody sync (TokNewLine) {
		(
			NEW_LINE | WORKSPACE_GLOBAL_ASSIGNMENT
		)*
	}

	rule WORKSPACE_GLOBAL_ASSIGNMENT -> NodeWorkspaceGlobalAssignment {
		NodeWorkspaceGlobalKey : TokIdentifier
		virtual TokEquals
		VARIABLE_VALUE
		NEW_LINE
	}

	rule WORKSPACE_EXCLUDE -> NodeWorkspaceExclude {
		virtual TokKWExclude
		STRING_LITERAL
		NEW_LINE
	}

	// --- ENTITY (Helm 2.0) ---

	rule ENTITY -> NodeEntity {
		virtual TokKWEntity
		NodeEntityName : TokIdentifier
		nest @Braces {
			ENTITY_BODY
		}
	}

	rule ENTITY_BODY -> NodeEntityBody sync (TokNewLine) {
		(
			NEW_LINE | ENTITY_KIND | ENTITY_USE | ENTITY_DEPS
			| ENTITY_INTERFACE | ENTITY_USAGE
		)*
	}

	rule ENTITY_KIND -> NodeEntityKind {
		call t_simpleAssignment(TokKWKind, STRING_LITERAL)
	}

	rule ENTITY_USE -> NodeEntityUse {
		virtual TokKWUse
		NodeEntityAdapterName : TokIdentifier
		ENTITY_USE_OPTIONS?
		NEW_LINE
	}

	rule ENTITY_USE_OPTIONS -> NodeEntityUseOptions {
		nest @Braces {
			ENTITY_USE_OPTIONS_BODY
		}
	}

	rule ENTITY_USE_OPTIONS_BODY -> NodeEntityUseOptionsBody sync (TokNewLine) {
		(
			NEW_LINE | DEPENDENCY_PARAMS
		)*
	}

	rule ENTITY_DEPS -> NodeEntityDeps {
		virtual TokKWDeps
		virtual TokEquals
		LABEL_ARRAY
		NEW_LINE
	}

	rule LABEL_ARRAY -> NodeLabelArray {
		using STD.t_MULTILINE_ARRAY_TRAILING_SEP(@Brackets, LABEL_REF, TokComma, TokNewLine)
	}

	rule LABEL_REF -> NodeLabelRef {
		STRING_LITERAL
	}

	rule ENTITY_INTERFACE -> NodeEntityInterface {
		virtual TokKWInterface
		using STD.t_MULTILINE_BLOCK(@Braces, ENTITY_INTERFACE_ASSIGNMENT, TokNewLine)
	}

	rule ENTITY_INTERFACE_ASSIGNMENT -> transparent gr_ENTITY_INTERFACE_ASSIGNMENT {
		call t_keyValuePair(NodeEntityInterfaceKey, TokIdentifier, STRING_LIST_ARRAY)
	}

	rule ENTITY_USAGE -> NodeEntityUsage {
		virtual TokKWUsage
		using STD.t_MULTILINE_BLOCK(@Braces, ENTITY_USAGE_ASSIGNMENT, TokNewLine)
	}

	rule ENTITY_USAGE_ASSIGNMENT -> transparent gr_ENTITY_USAGE_ASSIGNMENT {
		call t_keyValuePair(NodeEntityUsageKey, TokIdentifier, STRING_LIST_ARRAY)
	}

	// --- INTERFACE (Helm 2.0 property-bag key set) ---

	rule INTERFACE_DECL -> NodeInterfaceDecl {
		virtual TokKWInterface
		NodeInterfaceName : TokIdentifier
		nest @Braces {
			INTERFACE_BODY
		}
	}

	rule INTERFACE_BODY -> NodeInterfaceBody sync (TokNewLine) {
		(
			NEW_LINE | INTERFACE_KEYS
		)*
	}

	rule INTERFACE_KEYS -> NodeInterfaceKeys {
		call t_simpleAssignment(TokKWKeys, STRING_ARRAY)
	}

	// --- VARIABLES ---

	rule VARIABLE_STATEMENT -> NodeVariableDeclaration {
		NodeVariableName : TokIdentifier
		virtual TokEquals
		VARIABLE_VALUE
		NEW_LINE
	}

	rule VARIABLE_VALUE -> NodeVariableValue {
		TEXT_STRING | VARIABLE_ARRAY | VAR_REF
	}

	rule VARIABLE_ARRAY -> NodeVariableArray {
		PATH_ARRAY
	}

	// --- TARGETS ---

	pair Parens TokParenOpen TokParenClose;
	pair Braces TokBraceOpen TokBraceClose;
	pair Brackets TokBracketOpen TokBracketClose;

	rule TARGET -> NodeTarget {	
		virtual TokKWTarget
		call t_ALLOWED_TARGET_NAME(NodeTargetIdentifier)
		nest @Parens {
			TARGET_PARAMS
		}
		nest @Braces {
			TARGET_BODY
		}
	}

	rule TARGET_PARAMS -> NodeTargetParams {
		(
			TARGET_PARAM
			(
				virtual TokComma
				TARGET_PARAM
			)*
		)?
	}

	rule TARGET_PARAM -> NodeTargetParameter {
		NodeTargetParameterIdentifier : TokIdentifier
		NodeTargetParameterOptional : TokQuestion?
	}

	rule TARGET_BODY -> NodeTargetBody sync (TokNewLine) {
		(
			NEW_LINE | HELP_STATEMENT | ALIASES_DECLARATION | LET_BINDING | EXPORT_DECLARATION | ARTIFACTS_BLOCK | CONDITIONAL_BLOCK | DEPENDS_ON
			| RUN | WORK_DIR | ENV_DECLARATION | MATRIX_BLOCK | INTERACTIVE_STATEMENT | HIDDEN_STATEMENT
		)*
	}

	rule EXPORT_DECLARATION -> NodeExportDeclaration {
		virtual TokKWExport
		using STD.t_MULTILINE_BLOCK(@Braces, EXPORT_ASSIGNMENT, TokNewLine)
	}

	rule EXPORT_ASSIGNMENT -> transparent gr_EXPORT_ASSIGNMENT {
		call t_keyValuePair(NodeExportKey, TokIdentifier, EXPORT_VALUE)
	}

	rule EXPORT_VALUE -> transparent gr_EXPORT_VALUE {
		STRING_LITERAL | STRING_LIST_ARRAY
	}

	rule STRING_LIST_ARRAY -> NodeStringListArray {
		using STD.t_MULTILINE_ARRAY_TRAILING_SEP(@Brackets, STRING_LIST_ELEMENT, TokComma, TokNewLine)
	}

	rule STRING_LIST_ELEMENT -> transparent gr_STRING_LIST_ELEMENT {
		STRING_LITERAL | STRING_LIST_PARAM_REF | STRING_LIST_COLLECT_CALL | STRING_LIST_COLLECT_CLOSURE_CALL
	}

	rule STRING_LIST_PARAM_REF -> NodeStringListParamRef {
		virtual TokKWParam
		NodeStringListParamName : TokIdentifier
	}

	rule STRING_LIST_COLLECT_CALL -> NodeStringListCollectCall {
		virtual TokKWCollect
		nest @Parens {
			STRING_LIST_COLLECT_ARGS
		}
	}

	rule STRING_LIST_COLLECT_CLOSURE_CALL -> NodeStringListCollectClosureCall {
		virtual TokKWCollectClosure
		nest @Parens {
			STRING_LIST_COLLECT_ARGS
		}
	}

	rule STRING_LIST_COLLECT_ARGS -> NodeStringListCollectArgs {
		NodeStringListCollectDepsParam : TokIdentifier
		virtual TokComma
		STRING_LITERAL
	}

	rule LET_BINDING -> NodeLetBinding {
		virtual TokKWLet
		NodeLetBindingName : TokIdentifier
		virtual TokEquals
		PATH_EXPR
		NEW_LINE
	}

	rule PATH_EXPR -> transparent gr_PATH_EXPR {
		PATH_VAR_OR_CALL | STRING_LITERAL
	}

	rule PATH_VAR_OR_CALL -> NodePathVarOrCall {
		NodePathVarOrCallName : TokIdentifier
		PATH_CALL_ARGS?
	}

	rule PATH_CALL_ARGS -> NodePathCallArgs {
		using STD.t_MULTILINE_ARRAY_1_OR_MORE_TRAILING_SEP(@Parens, PATH_EXPR, TokComma, TokNewLine)
	}

	rule WORK_DIR -> NodeWorkingDirectory {
		call t_simpleAssignment(TokKWWorkingDir, STRING_LITERAL)
	}

	rule ENV_DECLARATION -> NodeEnvDeclaration {
		virtual TokKWEnv
		using STD.t_MULTILINE_BLOCK(@Braces, ENV_ASSIGNMENT, TokNewLine)
	}

	template t_keyValuePair($keyNode: Node, $keyToken: Token, $valueRule: Rule) {
		$keyNode : $keyToken
		virtual TokEquals
		$valueRule
	}

	rule ENV_ASSIGNMENT -> transparent gr_ENV_ASSIGNMENT {
		call t_keyValuePair(NodeEnvKey, TokIdentifier, ENV_VALUE)
	}

	rule ENV_VALUE -> transparent gr_ENV_VALUE {
		STRING_LITERAL | STRING_LIST_ARRAY
	}

	rule HELP_STATEMENT -> NodeHelpStatement {
		call t_simpleAssignment(TokKWHelp, TEXT_STRING)
	} 

	rule INTERACTIVE_STATEMENT -> NodeInteractiveStatement {
		call t_simpleAssignment(TokKWInteractive, TRUE_OR_FALSE)
	} 

	rule HIDDEN_STATEMENT -> NodeHiddenStatement {
		call t_simpleAssignment(TokKWHidden, TRUE_OR_FALSE)
	} 

	rule ALIASES_DECLARATION -> NodeAliases {
		call t_simpleAssignment(TokKWAliases, STRING_ARRAY)
	}

	rule ARTIFACTS_BLOCK -> NodeArtifactsBlock {
		virtual TokKWArtifacts
		using STD.t_MULTILINE_BLOCK(@Braces, ARTIFACTS_STATEMENT, TokNewLine)
	}

	rule ARTIFACTS_STATEMENT -> transparent gr_ARTIFACTS_STATEMENT {
		INPUTS_STATEMENT | OUTPUT_STATEMENT | VOLATILE_STATEMENT | DYNAMIC_STATEMENT
	}

	rule MATRIX_BLOCK -> NodeMatrixBlock {
		virtual TokKWMatrix
		NodeMatrixIdentifier : TokIdentifier
		virtual TokKWIn
		MATRIX_VALUE
	}

	rule MATRIX_VALUE -> transparent gr_MATRIX_VALUE {
		VAR_REF | STRING_LITERAL | GLOB | PATH | MATRIX_ARRAY
	}

	rule MATRIX_ARRAY -> NodeMatrixArray {
		using STD.t_MULTILINE_ARRAY_TRAILING_SEP(@Brackets, MATRIX_ARRAY_ELEMENT, TokComma, TokNewLine)
	}

	rule MATRIX_ARRAY_ELEMENT -> transparent gr_MATRIX_ARRAY_ELEMENT {
		STRING_LITERAL | GLOB | PATH | VAR_REF
	}

	// --- ADAPTER (Helm 2.0 dumb templates; after MATRIX_BLOCK for rule visibility) ---

	rule ADAPTER_DECL -> NodeAdapterDecl {
		virtual TokKWAdapter
		NodeAdapterName : TokIdentifier
		nest @Parens {
			TARGET_PARAMS
		}
		nest @Braces {
			ADAPTER_BODY
		}
	}

	rule ADAPTER_BODY -> NodeAdapterBody sync (TokNewLine) {
		(
			NEW_LINE | ADAPTER_PHASE | MATRIX_BLOCK | ADAPTER_OUTPUTS
			| ADAPTER_ENV | RUN
		)*
	}

	rule ADAPTER_PHASE -> NodeAdapterPhase {
		virtual TokKWTarget
		NodeAdapterPhaseName : TokIdentifier
		nest @Braces {
			ADAPTER_PHASE_BODY
		}
	}

	rule ADAPTER_PHASE_BODY -> NodeAdapterPhaseBody sync (TokNewLine) {
		(
			NEW_LINE | ADAPTER_PHASE_DEPENDS | MATRIX_BLOCK | ADAPTER_OUTPUTS
			| ADAPTER_ENV | RUN
		)*
	}

	rule ADAPTER_PHASE_DEPENDS -> NodeAdapterPhaseDepends {
		virtual TokKWDependsOn
		ADAPTER_PHASE_DEPENDS_ARRAY
		NEW_LINE
	}

	rule ADAPTER_PHASE_DEPENDS_ARRAY -> NodeAdapterPhaseDependsArray {
		using STD.t_MULTILINE_ARRAY_TRAILING_SEP(@Brackets, ADAPTER_PHASE_DEPENDS_NAME, TokComma, TokNewLine)
	}

	rule ADAPTER_PHASE_DEPENDS_NAME -> NodeAdapterPhaseDependsName {
		NodeAdapterPhaseDependsIdentifier : TokIdentifier
	}

	rule ADAPTER_OUTPUTS -> NodeAdapterOutputs {
		call t_simpleAssignment(TokKWOutputs, PATH_ARRAY)
	}

	rule ADAPTER_ENV -> NodeAdapterEnv {
		virtual TokKWEnv
		using STD.t_MULTILINE_BLOCK(@Braces, ENV_ASSIGNMENT, TokNewLine)
	}

	template t_simpleAssignment($keyword: Token, $rule: Rule) {
		virtual $keyword
		virtual TokEquals
		$rule
	}

	template t_simpleAssignmentExplicit($keyword: Token, $keywordNode: Node, $rule: Rule) {
		$keywordNode : $keyword
		virtual TokEquals
		$rule
	}

	rule INPUTS_STATEMENT -> NodeCacheInputs {
		call t_simpleAssignment(TokKWInputs, INPUTS_VALUE)
		NEW_LINE
	}

	rule INPUTS_VALUE -> transparent gr_INPUTS_VALUE {
		VAR_REF | STRING_LITERAL | GLOB | INPUT_ARRAY | PATH
	}

	rule INPUT_ARRAY -> NodeInputArray {
		PATH_ARRAY
	}

	rule VOLATILE_STATEMENT -> NodeVolatile {
		call t_simpleAssignment(TokKWVolatile, TRUE_OR_FALSE)
	}

	rule DYNAMIC_STATEMENT -> NodeDynamic {
		call t_simpleAssignment(TokKWDynamic, DYNAMIC_VALUE)
		NEW_LINE
	}

	rule DYNAMIC_VALUE -> transparent gr_DYNAMIC_VALUE {
		VAR_REF | STRING_LITERAL | GLOB | DYNAMIC_ARRAY | PATH
	}

	rule DYNAMIC_ARRAY -> NodeDynamicArray {
		PATH_ARRAY
	}

	rule GLOB -> NodeGlob {
		virtual TokKWGlob
		nest @Parens {
			GLOB_ARGS
		}
	}

	rule GLOB_ARGS -> NodeGlobArguments {
		GLOB_BASE_DIR
		(
			virtual TokComma
			GLOB_KWARG
		)*
	}

	rule GLOB_BASE_DIR -> NodeGlobBaseDirectory {
		VAR_REF
		| STRING_LITERAL
	}

	rule GLOB_KWARG -> NodeGlobKwarg {
		GLOB_INCLUDE_KWARG | GLOB_NAMED_KWARG
	}

	rule GLOB_INCLUDE_KWARG -> NodeGlobIncludeKwarg {
		virtual TokKWInclude
		virtual TokEquals
		(STRING_LITERAL | TRUE_OR_FALSE)
	}

	rule GLOB_NAMED_KWARG -> NodeGlobNamedKwarg {
		NodeGlobKwargIdentifier : TokIdentifier
		virtual TokEquals
		(STRING_LITERAL | TRUE_OR_FALSE)
	}

	rule OUTPUT_STATEMENT -> NodeCacheOutputDirectory {
		virtual TokKWOutputs
		virtual TokEquals
		OUTPUT_STATEMENT_VALUE
		NEW_LINE
	}

	rule OUTPUT_STATEMENT_VALUE -> transparent gr_OUTPUT_VALUE {
		VAR_REF | STRING_LITERAL | PATH | OUTPUT_ARRAY | GLOB
	}
	
	rule OUTPUT_ARRAY -> NodeOutputArray {
		PATH_ARRAY
	}

	rule PATH_ARRAY -> transparent gr_PATH_ARRAY {
		using STD.t_MULTILINE_ARRAY_TRAILING_SEP(@Brackets, PATH_ARRAY_ELEMENT, TokComma, TokNewLine)
	}

	rule PATH_ARRAY_ELEMENT -> transparent gr_PATH_ARRAY_ELEMENT {
		STRING_LITERAL | GLOB | PATH | VAR_REF
	}

	rule PATH -> NodePath {
		virtual TokKWPath
		nest @Parens {
			PATH_ARGS
		}
	}

	rule PATH_ARGS -> NodePathArgs {
		PATH_ELEMENT
		(
			virtual TokComma
			PATH_ELEMENT
		)*
	}

	rule PATH_ELEMENT -> transparent gr_PATH_ELEMENT {
		VAR_REF | STRING_LITERAL
	}

	rule CONDITIONAL_BLOCK -> NodeConditional sync (TokNewLine) {
		virtual TokKWWhen

		(DEFINES | EQUALS)

		nest @Braces {
			(
				NEW_LINE
				| TARGET_EXECUTION
			)*
		}	
	}

	rule DEFINES -> transparent gr_DEFINES {
		NodeCondition : (virtual TokKWDefined | virtual TokKWNotDefined)
		nest @Parens {
			NodeConditionalParameter : TokIdentifier
		}
	}

	rule EQUALS -> transparent gr_EQUALS {
		NodeCondition : (virtual TokKWEquals | virtual TokKWNotEquals)
		nest @Parens {
			NodeConditionalParameter : TokIdentifier
			virtual TokComma
			CONDITIONAL_TARGET 
		}
	}

	rule CONDITIONAL_TARGET -> NodeConditionalTarget {
		STRING_LITERAL | NodeNumber : TokInteger
	}

	rule TARGET_EXECUTION -> NodeTargetExecution {
		RUN
	}

	rule RUN -> NodeRunStatement {
		virtual TokKWRun
		(RUN_ARRAY | TEXT_STRING)
		NEW_LINE
	}

	rule RUN_ARRAY -> NodeRunArray {
		using STD.t_MULTILINE_ARRAY_TRAILING_SEP(@Brackets, RUN_ARRAY_ELEMENT, TokComma, TokNewLine)
	}

	rule RUN_ARRAY_ELEMENT -> transparent gr_RUN_ARRAY_ELEMENT {
		STRING_LITERAL | RUN_PARAM_REF | STRING_LIST_COLLECT_CALL | STRING_LIST_COLLECT_CLOSURE_CALL | RUN_ABS_PATH_CALL
	}

	rule RUN_ABS_PATH_CALL -> NodeRunAbsPathCall {
		NodeRunAbsPathCallName : TokIdentifier
		nest @Parens {
			STRING_LITERAL
		}
	}

	rule RUN_PARAM_REF -> NodeRunParameterRef {
		virtual TokKWParam
		NodeRunParameterName : TokIdentifier
		RUN_PHASE_OUTPUTS_SUFFIX?
	}

	rule RUN_PHASE_OUTPUTS_SUFFIX -> NodeRunPhaseOutputsSuffix {
		virtual TokDot
		NodeRunPhaseOutputsMember : TokIdentifier
	}

	rule TARGET_DEPENDENCY -> NodeTargetDependency {
		call t_ALLOWED_TARGET_NAME(NodeInvokeTarget)
		nest @Braces {
			DEPENDENCY_OPTIONS
		}?
	}

	rule DEPENDENCY_OPTIONS -> NodeDependencyOptions {
		(
			call t_simpleAssignmentExplicit(TokKWConfirm, NodeConfirmKW, TRUE_OR_FALSE)
			|
			call t_simpleAssignmentExplicit(TokKWOptional, NodeOptionalKW, TRUE_OR_FALSE)
			|
			DEPENDENCY_PARAMS
			|
			NEW_LINE
		)*
	}

	rule DEPENDENCY_PARAMS -> NodeDependencyParameters {
		virtual TokKWParams
		nest @Braces {
			DEPENDENCY_PARAM_CONTENT
		}
	}

	rule DEPENDENCY_PARAM_CONTENT -> transparent gr_DEPENDENCY_PARAM_CONTENT {
		(
			call t_keyValuePair(NodeDependencyParameterName, TokIdentifier, DEPENDENCY_PARAM_VALUE)
			|
			NEW_LINE
		)*
	}

	rule DEPENDENCY_PARAM_VALUE -> transparent gr_DEPENDENCY_PARAM_VALUE {
		STRING_LITERAL | VAR_REF | PARAM_VALUE_ARRAY
	}

	// PARAM_VALUE_ARRAY unifies string-list and target-list dependency params under one
	// bracket production so `[` is never ambiguous. Element kind disambiguates at parse time.
	rule PARAM_VALUE_ARRAY -> NodeParamValueArray {
		using STD.t_MULTILINE_ARRAY_TRAILING_SEP(@Brackets, PARAM_VALUE_ARRAY_ELEMENT, TokComma, TokNewLine)
	}

	rule PARAM_VALUE_ARRAY_ELEMENT -> transparent gr_PARAM_VALUE_ARRAY_ELEMENT {
		STRING_LITERAL | STRING_LIST_COLLECT_CALL | STRING_LIST_COLLECT_CLOSURE_CALL | PARAM_VALUE_PARAM_REF | TARGET_DEPENDENCY
		| GLOB
	}

	rule PARAM_VALUE_PARAM_REF -> NodeParamValueParamRef {
		virtual TokKWParam
		NodeParamValueParamName : TokIdentifier
	}

	rule TRUE_OR_FALSE -> gr_TRUE_OR_FALSE {
		NodeBoolean : (virtual TokKWTrue | virtual TokKWFalse)
	}

	rule DEPENDS_ON -> NodeTargetDepends {
		virtual TokKWDependsOn
		using STD.t_MULTILINE_ARRAY_TRAILING_SEP(@Brackets, DEPENDENCY_ELEMENT, TokComma, TokNewLine)
	}

	rule DEPENDENCY_ELEMENT -> transparent gr_DEP_EL {
		TARGET_DEPENDENCY
		| DEPENDENCY_PARAM_REF
		| ENTITY_LABEL_DEPENDENCY
	}

	rule ENTITY_LABEL_DEPENDENCY -> NodeEntityLabelDependency {
		LABEL_REF
	}

	rule DEPENDENCY_PARAM_REF -> NodeDependsOnParameterRef {
		virtual TokKWParam
		NodeDependencyParameterName : TokIdentifier
	}

	// --- STRINGS ---

	rule TEXT_STRING -> transparent gr_TEXT_STRING {
		STRING_LITERAL | MULTILINE_STRING
	}

	rule STRING_ARRAY -> NodeStringArray {
		using STD.t_MULTILINE_ARRAY_TRAILING_SEP(@Brackets, STRING_LITERAL, TokComma, TokNewLine)
	}

	rule MULTILINE_STRING -> NodeMultilineString {
		virtual TokMultilineStringStart
		(
			STRING_INTERPOLATION
			| NodeStringEscape : TokStringEscape
			| NodeStringText : TokMultilineStringText
			| NodeStringDollar : TokDollar
		)*
		virtual TokMultilineStringEnd
	}

	rule STRING_LITERAL -> NodeStringLiteral {
		STRING_BODY
	}

	rule STRING_BODY -> transparent gr_STRING_BODY {
		EMPTY_STRING | NONEMPTY_STRING
	}

	rule EMPTY_STRING -> transparent gr_EMPTY_STRING {
		virtual TokEmptyString
	}

	rule NONEMPTY_STRING -> transparent gr_NONEMPTY_STRING {
		virtual TokStringStart
		(
			STRING_INTERPOLATION
			| NodeStringEscape : TokStringEscape
			| NodeStringText : TokStringLiteral
			| NodeStringDollar : TokDollar
		)*
		virtual TokStringEnd
	}

	rule STRING_INTERPOLATION -> NodeStringInterpolation {
		virtual TokInterpolationStart
		NodeInterpolatedVariable : TokIdentifier
		virtual TokInterpolationEnd
	}

	// --- OTHER ---

	template t_ALLOWED_TARGET_NAME($outNode: Node) {
		$outNode : (
			virtual TokIdentifier 
			| virtual TokKWRun 
			| virtual TokKWArtifacts
			| virtual TokKWPath
		)
	}

	rule VAR_REF -> transparent gr_VAR_REF {
		NodeVariableReference : TokIdentifier
	}

	rule NEW_LINE -> transparent gr_NEW_LINE {
		virtual TokNewLine
	}
}