--- "Go Work" v1.0.0 | lspec v1.0.0 ---

PRAGMA {
	tool.sublime {
		enable = true;
		output-path = [
			"libs/lingua/go/artifacts/gowork.sublime-syntax",
			"/home/user/.config/sublime-text/Packages/User/gowork.sublime-syntax"
		];
	}

	tool.go_bindings {
		enable = true;
		output-path = "libs/lingua/go/artifacts/gowork_go_bindings.go";
		package-name = "artifacts";
		namespace-prefix = "GoWork";
	}
};

IMPORT {
	"std.lspec" as STD;
}

PATTERN {
	pat_TokKWUse            : "use";
}

LEX {
	state INITIAL {
	2 TokKWUse              -> GOWORK_STRUCTURAL_ROLE : pat_TokKWUse;
	1 TokKWGo               -> GOWORK_STRUCTURAL_ROLE : using STD.pat_TokKWGo;
	1 TokKWToolchain        -> GOWORK_STRUCTURAL_ROLE : using STD.pat_TokKWToolchain;
	1 TokKWGodebug          -> GOWORK_STRUCTURAL_ROLE : using STD.pat_TokKWGodebug;
	1 TokKWReplace          -> GOWORK_STRUCTURAL_ROLE : using STD.pat_TokKWReplace;
	1 TokModulePath         -> GOWORK_STRUCTURAL_ROLE : using STD.pat_TokModulePath;
	1 TokVersion            -> GOWORK_STRUCTURAL_ROLE : using STD.pat_TokVersion;
	1 TokFloat              -> GOWORK_STRUCTURAL_ROLE : using STD.pat_TokFloat;

	0 TokWhitespace         -> GOWORK_WHITESPACE_ROLE : using STD.pat_TokWhitespace;
	0 TokLineComment        -> GOWORK_COMMENT_ROLE    : using STD.pat_TokLineComment;

	0 TokParenOpen          -> GOWORK_STRUCTURAL_ROLE : using STD.pat_ParenOpen;
	0 TokParenClose         -> GOWORK_STRUCTURAL_ROLE : using STD.pat_ParenClose;
	0 TokArrow              -> GOWORK_STRUCTURAL_ROLE : using STD.pat_Arrow;
	0 TokEquals             -> GOWORK_STRUCTURAL_ROLE : using STD.pat_Equals;

	0 TokEOF                -> GOWORK_STRUCTURAL_ROLE : using STD.pat_TokEOF %% EOF=true %%;
	}
}

PARSE {
	IGNORE {
		GOWORK_WHITESPACE_ROLE GOWORK_COMMENT_ROLE
	};

	rule PROGRAM -> NodeProgram {
		BLOCK*
		virtual TokEOF
	}

	rule BLOCK -> transparent gr_BLOCK {
		using STD.GO_DECLARATION |
		using STD.TOOLCHAIN_STATEMENT |
		using STD.GODEBUG_STATEMENT |
		USE_STATEMENT | 
		using STD.REPLACE_STATEMENT
	}

	rule REPLACE_REFERENCE -> NodeReplaceReference { using STD.REPLACE_REFERENCE }

	rule GODEBUG_REFERENCE -> NodeGodebugReference { using STD.GODEBUG_REFERENCE }

	rule USE_STATEMENT -> NodeUseStatement {
		virtual TokKWUse
		(
			USE_REFERENCE |
			nest TokParenOpen TokParenClose {
				USE_REFERENCE*
			}
		)
	}

	rule USE_REFERENCE -> NodeUseReference {
		NodeUsePath : TokModulePath
	}

}