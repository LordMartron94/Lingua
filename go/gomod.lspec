--- "Go Mod" v1.0.0 | lspec v1.0.0 ---

PRAGMA {
	tool.sublime {
		enable = true;
		output-path = [
			"libs/lingua/go/artifacts/gomod.sublime-syntax",
			"/home/user/.config/sublime-text/Packages/User/gomod.sublime-syntax"
		];
	}

	tool.go_bindings {
		enable = true;
		output-path = "libs/lingua/go/artifacts/gomod_go_bindings.go";
		package-name = "artifacts";
		namespace-prefix = "GoMod";
	}
};

IMPORT {
	"std.lspec" as STD;
}

PATTERN {
	pat_TokKWModule         : "module";
	pat_TokKWRequire        : "require";
	pat_TokKWExclude        : "exclude";
	pat_TokKWRetract        : "retract";
	pat_TokKWTool           : "tool";

	pat_BracketOpen         : '[';
	pat_BracketClose        : ']';
	pat_Comma               : ',';
}

LEX {
	state INITIAL {
	2 TokKWModule           -> GOMOD_STRUCTURAL_ROLE : pat_TokKWModule;
	2 TokKWGo               -> GOMOD_STRUCTURAL_ROLE : using STD.pat_TokKWGo;
	2 TokKWRequire          -> GOMOD_STRUCTURAL_ROLE : pat_TokKWRequire;
	2 TokKWReplace          -> GOMOD_STRUCTURAL_ROLE : using STD.pat_TokKWReplace;
	2 TokKWExclude          -> GOMOD_STRUCTURAL_ROLE : pat_TokKWExclude;
	2 TokKWRetract          -> GOMOD_STRUCTURAL_ROLE : pat_TokKWRetract;
	2 TokKWToolchain        -> GOMOD_STRUCTURAL_ROLE : using STD.pat_TokKWToolchain;
	2 TokKWGodebug          -> GOMOD_STRUCTURAL_ROLE : using STD.pat_TokKWGodebug;
	2 TokKWTool             -> GOMOD_STRUCTURAL_ROLE : pat_TokKWTool;

	1 TokVersion            -> GOMOD_STRUCTURAL_ROLE : using STD.pat_TokVersion;
	1 TokModulePath         -> GOMOD_STRUCTURAL_ROLE : using STD.pat_TokModulePath;
	1 TokFloat              -> GOMOD_STRUCTURAL_ROLE : using STD.pat_TokFloat;

	// Hidden/Whitespace
	0 TokWhitespace         -> GOMOD_WHITESPACE_ROLE : using STD.pat_TokWhitespace;
	0 TokLineComment        -> GOMOD_COMMENT_ROLE    : using STD.pat_TokLineComment;

	// Structural characters
	0 TokParenOpen          -> GOMOD_STRUCTURAL_ROLE : using STD.pat_ParenOpen;
	0 TokParenClose         -> GOMOD_STRUCTURAL_ROLE : using STD.pat_ParenClose;
	0 TokArrow              -> GOMOD_STRUCTURAL_ROLE : using STD.pat_Arrow;
	0 TokEquals             -> GOMOD_STRUCTURAL_ROLE : using STD.pat_Equals;
	0 TokBracketOpen        -> GOMOD_STRUCTURAL_ROLE : pat_BracketOpen;
	0 TokBracketClose       -> GOMOD_STRUCTURAL_ROLE : pat_BracketClose;
	0 TokComma              -> GOMOD_STRUCTURAL_ROLE : pat_Comma;

	// End of File
	0 TokEOF                -> GOMOD_STRUCTURAL_ROLE : using STD.pat_TokEOF %% EOF=true %%;
	}
}

PARSE {
	IGNORE {
		GOMOD_WHITESPACE_ROLE GOMOD_COMMENT_ROLE
	};

	rule PROGRAM -> NodeProgram {
		BLOCK*
		virtual TokEOF
	}

	rule BLOCK -> transparent gr_BLOCK {
		MODULE_STATEMENT | 
		using STD.GO_DECLARATION | 
		REQUIRE_STATEMENT | 
		using STD.REPLACE_STATEMENT |
		EXCLUDE_STATEMENT | 
		RETRACT_STATEMENT | 
		using STD.TOOLCHAIN_STATEMENT | 
		using STD.GODEBUG_STATEMENT | 
		TOOL_STATEMENT
	}

	rule MODULE_STATEMENT -> NodeModuleStatement {
		virtual TokKWModule
		NodeModuleName : TokModulePath
	}

	rule REQUIRE_STATEMENT -> NodeRequireStatement {
		virtual TokKWRequire
		(
			MODULE_REFERENCE |
			nest TokParenOpen TokParenClose {
				MODULE_REFERENCE*
			}
		)
	}

	rule MODULE_REFERENCE -> NodeModuleReference {
		NodeModuleReferenceIdent : TokModulePath
		NodeModuleReferenceVersion : TokVersion
	}

	rule REPLACE_REFERENCE -> NodeReplaceReference { using STD.REPLACE_REFERENCE }

	rule EXCLUDE_STATEMENT -> NodeExcludeStatement {
		virtual TokKWExclude
		(
			MODULE_REFERENCE |
			nest TokParenOpen TokParenClose {
				MODULE_REFERENCE*
			}
		)
	}

	rule RETRACT_STATEMENT -> NodeRetractStatement {
		virtual TokKWRetract
		(
			RETRACT_REFERENCE |
			nest TokParenOpen TokParenClose {
				RETRACT_REFERENCE*
			}
		)
	}

	rule RETRACT_REFERENCE -> NodeRetractReference {
		NodeRetractSingle : TokVersion |
		RETRACT_RANGE
	}

	rule RETRACT_RANGE -> NodeRetractRange {
		nest TokBracketOpen TokBracketClose {
			NodeRetractLow : TokVersion
			virtual TokComma
			NodeRetractHigh : TokVersion
		}
	}

	rule GODEBUG_REFERENCE -> NodeGodebugReference { using STD.GODEBUG_REFERENCE }

	rule TOOL_STATEMENT -> NodeToolStatement {
		virtual TokKWTool
		(
			TOOL_REFERENCE |
			nest TokParenOpen TokParenClose {
				TOOL_REFERENCE*
			}
		)
	}

	rule TOOL_REFERENCE -> NodeToolReference {
		NodeToolPath : TokModulePath
	}
}